{
  "name": "thinking-explorer",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "server",
    "web"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:*",
    "dev:server": "npm --workspace server run dev",
    "dev:web": "npm --workspace web run dev",
    "build": "npm-run-all build:shared build:server build:web",
    "build:shared": "npm --workspace @thinking-explorer/shared run build",
    "build:server": "npm --workspace server run build",
    "build:web": "npm --workspace web run build",
    "typecheck": "npm-run-all typecheck:*",
    "typecheck:shared": "npm --workspace @thinking-explorer/shared run typecheck",
    "typecheck:server": "npm --workspace server run typecheck",
    "typecheck:web": "npm --workspace web run typecheck",
    "test": "npm-run-all test:shared test:server test:web",
    "test:shared": "npm --workspace @thinking-explorer/shared run test",
    "test:server": "npm --workspace server run test",
    "test:web": "npm --workspace web run test"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "typescript": "^5.6.3"
  }
}
