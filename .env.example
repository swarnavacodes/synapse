# Required for LLM-backed actions such as Expand, Connect, and Challenge.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional server settings.
PORT=4000
DATABASE_PATH=./server/data/synapse.db
OPENROUTER_MODEL=minimax/minimax-m3:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_MS=30000
OPENROUTER_FALLBACK_MODELS=minimax/minimax-m3:free,nvidia/nemotron-3.5-lightning:free,poolside/laguna-s-2.1:free,minimax/minimax-m2.7:free,nvidia/nemotron-3-super-120b-a12b:free,inclusionai/ling-3.0-flash-fin:free,dots-studio/dots-3-note-preview:free

# Web search (Tavily keyless — no API key needed, rate-limited).
# Set TAVILY_API_KEY only if you want higher limits.
# TAVILY_API_KEY=tvly-...